# Nomes exatos dos grupos, como aparecem no WhatsApp (usados para localizar o JID automaticamente).
SOURCE_GROUP_1_NAME="Networking Premium - BIZ / TECH / DIGITAL"
SOURCE_GROUP_2_NAME="MCIO Oportunidades de mercado"
TARGET_GROUP_NAME="CS Mentoria de Carreira | Tech Women"

# Alternativa: se dois grupos tiverem o mesmo nome, defina o JID exato aqui (ex: 12036304xxxx-xxxxxxxxxx@g.us)
# Obtenha os JIDs rodando: npm run list-groups
# SOURCE_GROUP_1_JID=
# SOURCE_GROUP_2_JID=
# TARGET_GROUP_JID=

# Horários de envio (formato cron, hora local do fuso abaixo)
SCHEDULE_CRON_1="0 10 * * *"
SCHEDULE_CRON_2="0 16 * * *"
TIMEZONE="America/Sao_Paulo"

# Pasta onde a sessão autenticada do WhatsApp fica salva
AUTH_DIR="./auth"

# Pasta onde as mensagens recebidas ficam guardadas até o próximo envio
DATA_DIR="./data"
